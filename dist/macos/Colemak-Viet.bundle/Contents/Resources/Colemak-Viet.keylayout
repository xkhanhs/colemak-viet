    <actions>
        <action id="ch_A">
            <when state="none" output="A"/>
            <when state="grave" output="À"/>
            <when state="acute" output="Á"/>
            <when state="circ" output="Â"/>
            <when state="tilde" output="Ã"/>
            <when state="uml" output="Ä"/>
        </action>
        <action id="ch_E">
            <when state="none" output="E"/>
            <when state="grave" output="È"/>
            <when state="acute" output="É"/>
            <when state="circ" output="Ê"/>
            <when state="uml" output="Ë"/>
        </action>
        <action id="ch_I">
            <when state="none" output="I"/>
            <when state="grave" output="Ì"/>
            <when state="acute" output="Í"/>
            <when state="circ" output="Î"/>
            <when state="uml" output="Ï"/>
        </action>
        <action id="ch_N">
            <when state="none" output="N"/>
            <when state="tilde" output="Ñ"/>
        </action>
        <action id="ch_O">
            <when state="none" output="O"/>
            <when state="grave" output="Ò"/>
            <when state="acute" output="Ó"/>
            <when state="circ" output="Ô"/>
            <when state="tilde" output="Õ"/>
            <when state="uml" output="Ö"/>
        </action>
        <action id="ch_U">
            <when state="none" output="U"/>
            <when state="grave" output="Ù"/>
            <when state="acute" output="Ú"/>
            <when state="circ" output="Û"/>
            <when state="uml" output="Ü"/>
        </action>
        <action id="ch_Y">
            <when state="none" output="Y"/>
            <when state="acute" output="Ý"/>
            <when state="uml" output="Ÿ"/>
        </action>
        <action id="ch_a">
            <when state="none" output="a"/>
            <when state="grave" output="à"/>
            <when state="acute" output="á"/>
            <when state="circ" output="â"/>
            <when state="tilde" output="ã"/>
            <when state="uml" output="ä"/>
        </action>
        <action id="ch_e">
            <when state="none" output="e"/>
            <when state="grave" output="è"/>
            <when state="acute" output="é"/>
            <when state="circ" output="ê"/>
            <when state="uml" output="ë"/>
        </action>
        <action id="ch_i">
            <when state="none" output="i"/>
            <when state="grave" output="ì"/>
            <when state="acute" output="í"/>
            <when state="circ" output="î"/>
            <when state="uml" output="ï"/>
        </action>
        <action id="ch_n">
            <when state="none" output="n"/>
            <when state="tilde" output="ñ"/>
        </action>
        <action id="ch_o">
            <when state="none" output="o"/>
            <when state="grave" output="ò"/>
            <when state="acute" output="ó"/>
            <when state="circ" output="ô"/>
            <when state="tilde" output="õ"/>
            <when state="uml" output="ö"/>
        </action>
        <action id="ch_u">
            <when state="none" output="u"/>
            <when state="grave" output="ù"/>
            <when state="acute" output="ú"/>
            <when state="circ" output="û"/>
            <when state="uml" output="ü"/>
        </action>
        <action id="ch_y">
            <when state="none" output="y"/>
            <when state="acute" output="ý"/>
            <when state="uml" output="ÿ"/>
        </action>
        <action id="dead_grave">
            <when state="none" next="grave"/>
        </action>
        <action id="dead_acute">
            <when state="none" next="acute"/>
        </action>
        <action id="dead_circ">
            <when state="none" next="circ"/>
        </action>
        <action id="dead_tilde">
            <when state="none" next="tilde"/>
        </action>
        <action id="dead_uml">
            <when state="none" next="uml"/>
        </action>
        <action id="ch_space">
            <when state="none" output=" "/>
            <when state="grave" output="`"/>
            <when state="acute" output="´"/>
            <when state="circ" output="ˆ"/>
            <when state="tilde" output="˜"/>
            <when state="uml" output="¨"/>
        </action>
    </actions>
    <terminators>
        <when state="grave" output="`"/>
        <when state="acute" output="´"/>
        <when state="circ" output="ˆ"/>
        <when state="tilde" output="˜"/>
        <when state="uml" output="¨"/>
    </terminators>
</keyboard>
